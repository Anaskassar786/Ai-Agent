# ==============================================================================
# PROFIT TOOL — Enterprise Decision Support Suite for Shopify Merchants
# Exact Match Environment Configuration (Document 13B)
# ==============================================================================
# Copy this file to `.env` or configure these variables in your deployment environment
# (Cloud Run, Docker, Kubernetes, or Shopify App Engine).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Runtime & Hosting Environment
# ------------------------------------------------------------------------------
# NODE_ENV: Application running mode (development, production, or test)
NODE_ENV="production"

# APP_URL: Public ingress host URL where this application is accessible
APP_URL="http://localhost:3000"

# PORT: Hardcoded infrastructure port (3000 is required for AI Studio ingress)
PORT="3000"

# ------------------------------------------------------------------------------
# 2. AI Engine & Explainability (Google Gemini API)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for server-side AI evaluation and recommendation generation.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ------------------------------------------------------------------------------
# 3. Cryptographic Security & Authentication (RBAC / JWT)
# ------------------------------------------------------------------------------
# JWT_SECRET: Secret key for signing access tokens (HMAC SHA-256)
JWT_SECRET="profit-tool-enterprise-super-secret-jwt-key-2026"

# JWT_REFRESH_SECRET: Secret key for signing long-lived refresh tokens
JWT_REFRESH_SECRET="profit-tool-enterprise-refresh-secret-key-2026"

# ------------------------------------------------------------------------------
# 4. Shopify App Integration & Webhook Signing
# ------------------------------------------------------------------------------
# SHOPIFY_API_KEY: Shopify Partner App Client ID
SHOPIFY_API_KEY="shpss_sample_shopify_api_key_38291038"

# SHOPIFY_API_SECRET: Shopify Partner App Client Secret
SHOPIFY_API_SECRET="shpss_sample_shopify_api_secret_49201920"

# SHOPIFY_WEBHOOK_SECRET: Secret used to verify X-Shopify-Hmac-Sha256 webhook signatures
SHOPIFY_WEBHOOK_SECRET="shopify_enterprise_webhook_secret_2026"

# SHOPIFY_SCOPES: Required OAuth scopes for enterprise decision support
SHOPIFY_SCOPES="read_orders,read_customers,read_checkouts,read_products,write_checkouts"

# ------------------------------------------------------------------------------
# 5. Database & Persistence Layer (PostgreSQL / Embedded Engine)
# ------------------------------------------------------------------------------
# DATABASE_URL: PostgreSQL connection string (Cloud SQL / Neon / RDS / Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/profit_tool_db?schema=public"

# USE_EMBEDDED_DB: Set to "true" to enable seamless SQLite/Memory embedded fallback
# when external PostgreSQL instances are unreachable in sandbox environments.
USE_EMBEDDED_DB="true"

# ------------------------------------------------------------------------------
# 6. Enterprise Observability & Notifications
# ------------------------------------------------------------------------------
# LOG_LEVEL: Standard logging verbosity (DEBUG, INFO, WARN, ERROR, AUDIT)
LOG_LEVEL="INFO"

# Redis URL for asynchronous background evaluation queues
REDIS_URL="redis://localhost:6379"

# Notification Alerting (Mailgun / SendGrid / SMTP)
SMTP_HOST="smtp.mailgun.org"
SMTP_PORT="587"
SMTP_USER="notifications@profittool.ai"
SMTP_PASS="secret_smtp_password"
DEFAULT_FROM_EMAIL="alerts@profittool.ai"


